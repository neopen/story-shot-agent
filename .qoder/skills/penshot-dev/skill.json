{
  "name": "penshot-dev",
  "version": "1.0.0",
  "description": "PenShot 项目开发助手（Qoder 版）：基于 .qoder/repowiki/、rules/ 与当前源码提供开发、审查、调试与文档支持。",
  "metadata_scope": "project_skill_metadata",
  "role": "developer",
  "capabilities": [
    "code_generation",
    "code_review",
    "test_generation",
    "debugging",
    "architecture_analysis",
    "documentation_generation"
  ],
  "project_context": {
    "repository": "https://github.com/neopen/story-shot-agent",
    "main_branch": "main",
    "python": ">=3.10",
    "tech_stack": [
      "LangChain",
      "LangGraph",
      "FastAPI",
      "Uvicorn",
      "Redis",
      "ChromaDB",
      "llama-index",
      "Pydantic v2",
      "pytest"
    ],
    "core_modules": [
      "src/penshot/api/",
      "src/penshot/neopen/task/",
      "src/penshot/neopen/agent/workflow/",
      "src/penshot/neopen/agent/",
      "src/penshot/neopen/knowledge/",
      "src/penshot/config/",
      "tests/"
    ]
  },
  "coding_standards": {
    "python_version": ">=3.10",
    "formatter": "ruff-format",
    "linter": "ruff",
    "type_checker": "mypy",
    "markdown_formatter": "mdformat",
    "docstrings": "遵循仓库现有中文注释与文档字符串约定",
    "test_framework": "pytest",
    "test_configuration_source": "pyproject.toml",
    "quality_configuration_source": ".pre-commit-config.yaml"
  },
  "development_workflow": {
    "source_of_truth": [
      "当前源码与测试",
      "pyproject.toml",
      ".pre-commit-config.yaml",
      ".qoder/rules/SDD-Agent.md",
      ".qoder/rules/coding-standards.md",
      ".qoder/rules/architecture-guardrails.md"
    ],
    "verification": "按变更范围运行受影响测试和质量检查",
    "security": "共享文件不得包含真实凭据"
  },
  "references": [
    "SKILL.md",
    "prompts/system_prompt.md",
    "references/coding_standards.md",
    "../../project_understanding.md",
    "../../rules/coding-standards.md",
    "../../rules/architecture-guardrails.md"
  ]
}
