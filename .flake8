[flake8]
# 最大允许的单行长度（匹配 Black 等常见格式化工具的标准）
max-line-length = 120

# 忽略/排除检查的文件和文件夹
exclude =
    .claude,
    .github,
    .qoder,
    assets,
    docs,
    web,
    examples,
    build,
    dist,
    .git,
    __pycache__,
    .venv,
    venv,
    *.egg-info

# 全局忽略的次要告警代码（避免与格式化工具冲突）
# E203: `:` 前的空格
# W503: 换行符在二元运算符之前
ignore = E203, W503

# 针对特定路径自定义忽略规则
per-file-ignores =
    # 允许 __init__.py 中导出未使用的包，不报 F401 错误
    __init__.py: F401
    # 允许测试文件中使用断言和局部未定义调整
    tests/*: F811
